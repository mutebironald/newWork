# ==============================================================================
# NewWork AI Workforce Platform — Environment Variables Template (.env.example)
# Copy this file to `.env` and replace placeholder values with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_PATH="/newwork"
SESSION_SECRET="your_random_session_secret_min_32_chars_here"

# ------------------------------------------------------------------------------
# 2. AI Credentials (Google Gemini)
# Required for AI Work Designer, skill profiling, multimodal OCR, & fraud detection
# Get key: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 3. Payment Gateway (Stripe)
# Required for organization subscriptions and field agent product checkouts
# Dashboard: https://dashboard.stripe.com/test/apikeys
# ------------------------------------------------------------------------------
# Leave blank or set to "mock_secret_key" to enable simulated checkout mode for offline testing
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_here"

# Optional Stripe Price IDs (If omitted, dynamic price_data will be generated automatically)
STRIPE_PRICE_COHORT_PACK="price_1..."
STRIPE_PRICE_PARTNER="price_1..."
STRIPE_PRICE_PLUS="price_1..."
STRIPE_PRICE_LAUNCH_KIT="price_1..."

# ------------------------------------------------------------------------------
# 4. Firebase Database Configuration (Cloud Firestore)
# Leave blank to use local Firestore mock in .firebase_mock directory
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
